<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand launch theme (DESIGN.md §2): the app is dark-only; the
         splash must never flash white before the Flutter UI draws. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/night950</item>
        <item name="android:navigationBarColor">@color/night950</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has
         started. This theme determines the color of the Android Window
         while your Flutter UI initializes. -->
    <style name="NormalTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night950</item>
    </style>
</resources>
